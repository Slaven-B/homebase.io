// HomeBase database schema.
//
// Phase 1 establishes the core identity model: users, households and
// membership. Feature entities (expenses, bills, chores, ...) are added in
// later phases, always carrying a `householdId` for authorization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users
//
// `email` is stored lowercased by the application (normalized in the service
// layer), so the plain unique index is case-insensitive in practice.
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships            HouseholdMember[]
  sentInvitations        HouseholdInvitation[] @relation("InvitationInviter")
  refreshTokens          RefreshToken[]
  activities             Activity[]
  createdShoppingLists   ShoppingList[]        @relation("ShoppingListCreator")
  addedShoppingItems     ShoppingListItem[]    @relation("ShoppingItemAdder")
  completedShoppingItems ShoppingListItem[]    @relation("ShoppingItemCompleter")
  createdTasks           Task[]                @relation("TaskCreator")
  assignedTasks          Task[]                @relation("TaskAssignee")
  taskComments           TaskComment[]
  createdChores          Chore[]               @relation("ChoreCreator")
  assignedChores         Chore[]               @relation("ChoreAssignee")
  choreCompletions       ChoreCompletion[]
  createdExpenses        Expense[]             @relation("ExpenseCreator")
  paidExpenses           Expense[]             @relation("ExpensePayer")
  expenseSplits          ExpenseSplit[]
  settlementsFrom        Settlement[]          @relation("SettlementFrom")
  settlementsTo          Settlement[]          @relation("SettlementTo")
  createdSettlements     Settlement[]          @relation("SettlementCreator")
  createdBills           Bill[]                @relation("BillCreator")
  responsibleBills       Bill[]                @relation("BillResponsible")
  billPayments           BillPayment[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Households & membership
// ---------------------------------------------------------------------------

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// ISO 4217 code used as the default for new expenses and for balances.
  currency  String   @default("EUR")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members       HouseholdMember[]
  activities    Activity[]
  shoppingLists ShoppingList[]
  tasks         Task[]
  chores        Chore[]
  expenses      Expense[]
  settlements   Settlement[]
  bills         Bill[]
  invitations   HouseholdInvitation[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

model HouseholdInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  householdId String           @map("household_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  email       String
  role        HouseholdRole    @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([email])
  @@map("household_invitations")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// Opaque refresh tokens. Only a SHA-256 hash is stored; the raw token lives in an
/// httpOnly cookie. Tokens are rotated on every refresh; presenting a revoked token
/// is treated as reuse and revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Groups tokens that descend from one login so reuse can revoke the chain.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Activity feed
// ---------------------------------------------------------------------------

/// Append-only log of what happened in a household, written by services
/// (never by clients). `action` is a stable string like "household.created";
/// `metadata` carries the details needed to render a sentence.
model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  /// Actor. Null when the actor account was deleted.
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt(sort: Desc)])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Shopping lists
// ---------------------------------------------------------------------------

model ShoppingList {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  name        String
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("ShoppingListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     ShoppingListItem[]

  @@index([householdId, isArchived])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id            String    @id @default(uuid()) @db.Uuid
  listId        String    @map("list_id") @db.Uuid
  addedById     String?   @map("added_by_id") @db.Uuid
  completedById String?   @map("completed_by_id") @db.Uuid
  name          String
  /// Free text so "2", "500 g" and "1 pack" all work.
  quantity      String?
  category      String?
  notes         String?
  completed     Boolean   @default(false)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy     User?        @relation("ShoppingItemAdder", fields: [addedById], references: [id], onDelete: SetNull)
  completedBy User?        @relation("ShoppingItemCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([listId, completed])
  @@map("shopping_list_items")
}

// ---------------------------------------------------------------------------
// Tasks (one-off) and chores (recurring)
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  householdId String     @map("household_id") @db.Uuid
  createdById String?    @map("created_by_id") @db.Uuid
  assigneeId  String?    @map("assignee_id") @db.Uuid
  title       String
  description String?
  /// Date-only (no time of day).
  dueAt       DateTime?  @map("due_at") @db.Date
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  TaskComment[]

  @@index([householdId, status])
  @@index([householdId, dueAt])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

enum ChoreFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  /// Every `intervalDays` days.
  CUSTOM
}

model Chore {
  id               String         @id @default(uuid()) @db.Uuid
  householdId      String         @map("household_id") @db.Uuid
  createdById      String?        @map("created_by_id") @db.Uuid
  assigneeId       String?        @map("assignee_id") @db.Uuid
  title            String
  description      String?
  frequency        ChoreFrequency
  intervalDays     Int?           @map("interval_days")
  /// Date-only. Advanced on complete/skip.
  nextDueAt        DateTime       @map("next_due_at") @db.Date
  estimatedMinutes Int?           @map("estimated_minutes")
  priority         Priority       @default(MEDIUM)
  isActive         Boolean        @default(true) @map("is_active")
  lastCompletedAt  DateTime?      @map("last_completed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("ChoreCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee    User?             @relation("ChoreAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completions ChoreCompletion[]

  @@index([householdId, isActive, nextDueAt])
  @@map("chores")
}

/// One row per completion or skip, so history and streaks can be shown later.
model ChoreCompletion {
  id            String   @id @default(uuid()) @db.Uuid
  choreId       String   @map("chore_id") @db.Uuid
  completedById String?  @map("completed_by_id") @db.Uuid
  /// The scheduled date this completion/skip was for.
  dueAt         DateTime @map("due_at") @db.Date
  skipped       Boolean  @default(false)
  note          String?
  completedAt   DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  chore       Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completedBy User? @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@index([choreId, completedAt(sort: Desc)])
  @@map("chore_completions")
}

// ---------------------------------------------------------------------------
// Shared expenses & settlements
// ---------------------------------------------------------------------------

enum SplitMethod {
  EQUAL
  CUSTOM
  PERCENTAGE
}

/// Amounts are integer cents (minor units) to keep arithmetic exact.
model Expense {
  id          String      @id @default(uuid()) @db.Uuid
  householdId String      @map("household_id") @db.Uuid
  createdById String?     @map("created_by_id") @db.Uuid
  paidById    String?     @map("paid_by_id") @db.Uuid
  description String
  amountCents Int         @map("amount_cents")
  currency    String
  /// Date-only.
  date        DateTime    @db.Date
  category    String?
  notes       String?
  splitMethod SplitMethod @map("split_method")
  receiptUrl  String?     @map("receipt_url")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  household    Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  paidBy       User?          @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)
  splits       ExpenseSplit[]
  billPayments BillPayment[]

  @@index([householdId, date(sort: Desc)])
  @@index([householdId, category])
  @@map("expenses")
}

model ExpenseSplit {
  id          String @id @default(uuid()) @db.Uuid
  expenseId   String @map("expense_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  amountCents Int    @map("amount_cents")
  /// Informational, only set for PERCENTAGE splits.
  percent     Float?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

/// A payment between two members that reduces what one owes the other.
model Settlement {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  fromUserId  String   @map("from_user_id") @db.Uuid
  toUserId    String   @map("to_user_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  currency    String
  date        DateTime @db.Date
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("SettlementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  fromUser  User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([householdId, date(sort: Desc)])
  @@map("settlements")
}

// ---------------------------------------------------------------------------
// Bills
// ---------------------------------------------------------------------------

enum BillFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  YEARLY
}

/// A bill template plus its next occurrence. Paying advances `dueDate` by one
/// period (or deactivates a ONE_TIME bill) and writes a BillPayment row.
model Bill {
  id            String        @id @default(uuid()) @db.Uuid
  householdId   String        @map("household_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  responsibleId String?       @map("responsible_id") @db.Uuid
  name          String
  amountCents   Int           @map("amount_cents")
  currency      String
  /// Date-only: the next (or only) due date.
  dueDate       DateTime      @map("due_date") @db.Date
  frequency     BillFrequency
  category      String?
  notes         String?
  isActive      Boolean       @default(true) @map("is_active")
  lastPaidAt    DateTime?     @map("last_paid_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("BillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  responsible User?         @relation("BillResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  payments    BillPayment[]

  @@index([householdId, isActive, dueDate])
  @@map("bills")
}

model BillPayment {
  id          String   @id @default(uuid()) @db.Uuid
  billId      String   @map("bill_id") @db.Uuid
  paidById    String?  @map("paid_by_id") @db.Uuid
  /// Optional shared expense created for this payment.
  expenseId   String?  @map("expense_id") @db.Uuid
  /// The occurrence this payment covered.
  dueDate     DateTime @map("due_date") @db.Date
  amountCents Int      @map("amount_cents")
  paidAt      DateTime @map("paid_at") @db.Date
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  paidBy  User?    @relation(fields: [paidById], references: [id], onDelete: SetNull)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([billId, paidAt(sort: Desc)])
  @@map("bill_payments")
}
