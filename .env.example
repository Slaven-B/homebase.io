# ------------------------------------------------------------------
# HomeBase environment configuration
# Copy to `.env` at the repository root. docker-compose reads it,
# and the API loads it via @nestjs/config.
# ------------------------------------------------------------------

# --- PostgreSQL (used by docker-compose) ---------------------------
POSTGRES_USER=homebase
POSTGRES_PASSWORD=homebase
POSTGRES_DB=homebase
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://homebase:homebase@localhost:5432/homebase?schema=public
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:4200

# --- Web ------------------------------------------------------------
WEB_PORT=4200

# --- Authentication -------------------------------------------------
# Random secret (>= 32 chars) used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Time zone for the API container (daily reminders run at 08:00 in this zone).
TZ=UTC
