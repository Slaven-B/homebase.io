# ------------------------------------------------------------------
# HomeBase environment configuration
# Copy to `.env` at the repository root. docker-compose reads it,
# and the API loads it via @nestjs/config.
# ------------------------------------------------------------------

# --- PostgreSQL (used by docker-compose) ---------------------------
POSTGRES_USER=homebase
POSTGRES_PASSWORD=homebase
POSTGRES_DB=homebase
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://homebase:homebase@localhost:5432/homebase?schema=public
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:4200

# --- Web ------------------------------------------------------------
WEB_PORT=4200
